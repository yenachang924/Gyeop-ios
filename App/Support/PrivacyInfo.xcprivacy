<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 겹은 서버가 없다. 카드·겹 기록은 기기 안(SwiftData)에만 남고 어디로도 나가지 않는다. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
				UserDefaults 사용처:
				- App/AppModel.swift  재설치 감지 플래그 (앱 자신이 쓴 값만 읽고 쓴다)
				- Packages/.../DataKit/ClipMigrationReceiver.swift
				  App Group(group.com.gyeop.app) 우편함에서 클립이 남긴 겹 기록을 회수
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!--
				App/Features/Onboarding/EmojiKeyboardField.swift 의 EmojiUITextField가
				활성 키보드 목록에서 이모지 키보드를 찾아 그 필드에 띄운다 (F63).
				54BD.1 — 텍스트 입력 필드를 가진 앱이 활성 키보드에 따라 사용자가 관찰
				가능한 방식으로 다르게 동작하기 위해 접근하는 경우. 읽은 정보는 기기 밖으로
				나가지 않는다.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryActiveKeyboards</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>54BD.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
